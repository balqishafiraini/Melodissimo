<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>MelodissimoOnlineServices</key>
	<true/>
	<key>MelodissimoBackendEnabled</key>
	<true/>
	<key>MelodissimoAPIBaseURL</key>
	<string>$(MELODISSIMO_API_BASE)</string>
	<key>MelodissimoCDNBaseURL</key>
	<string>$(MELODISSIMO_CDN_BASE)</string>
	<key>MelodissimoTermsURL</key>
	<string>$(MELODISSIMO_TERMS_URL)</string>
	<key>MelodissimoPrivacyURL</key>
	<string>$(MELODISSIMO_PRIVACY_URL)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>launchBackground</string>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>BalooDa-Regular.ttf</string>
	</array>
</dict>
</plist>
